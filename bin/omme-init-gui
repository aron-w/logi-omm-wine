#!/usr/bin/env bash
set -euo pipefail

if command -v xterm >/dev/null 2>&1; then
  exec xterm -title "Initialize OMME" -e omme-init "$@"
fi

if command -v kgx >/dev/null 2>&1; then
  exec kgx --title "Initialize OMME" -- omme-init "$@"
fi

if command -v gnome-terminal >/dev/null 2>&1; then
  exec gnome-terminal --title "Initialize OMME" -- omme-init "$@"
fi

if command -v konsole >/dev/null 2>&1; then
  exec konsole --title "Initialize OMME" -e omme-init "$@"
fi

exec omme-init "$@"
