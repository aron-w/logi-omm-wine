#!/usr/bin/env bash
set -euo pipefail

if command -v xterm >/dev/null 2>&1; then
  exec xterm -title "Initialize logi-omm-wine" -e logi-omm-wine-init "$@"
fi

if command -v kgx >/dev/null 2>&1; then
  exec kgx --title "Initialize logi-omm-wine" -- logi-omm-wine-init "$@"
fi

if command -v gnome-terminal >/dev/null 2>&1; then
  exec gnome-terminal --title "Initialize logi-omm-wine" -- logi-omm-wine-init "$@"
fi

if command -v konsole >/dev/null 2>&1; then
  exec konsole --title "Initialize logi-omm-wine" -e logi-omm-wine-init "$@"
fi

exec logi-omm-wine-init "$@"
